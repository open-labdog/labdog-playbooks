// MySQL / MariaDB slow query log collection — deployed to linux_databases hosts.
// Tails the slow query log and ships entries to Loki with a "db_host" label.

local.file_match "mysql_slow" {
  path_targets = [{ __path__ = "/var/log/mysql/mysql-slow.log" }]
}

loki.source.file "mysql_slow" {
  targets    = local.file_match.mysql_slow.targets
  forward_to = [loki.write.loki.receiver]

  labels = {
    job      = "mysql_slow_query",
    db_host  = "{{ inventory_hostname }}",
  }
}
