// Nginx stub-status metrics — deployed to hosts in the linux_webservers group.
// Requires: nginx compiled with ngx_http_stub_status_module and the
// following location block in your nginx config:
//
//   location /nginx_status {
//     stub_status;
//     allow 127.0.0.1;
//     deny all;
//   }

prometheus.scrape "nginx" {
  targets = [{ __address__ = "127.0.0.1:80" }]
  metrics_path = "/nginx_status"
  job_name     = "nginx"

  forward_to = [prometheus.remote_write.mimir.receiver]
}
