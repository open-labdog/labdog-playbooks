// Managed by Ansible — do not edit manually

prometheus.remote_write "labdog" {
  // LabDog stamps every shipped series with the host's stable identity so
  // it can query the metrics back on the host page. These are injected by
  // LabDog at dispatch; when Alloy is installed outside LabDog they are
  // empty strings, which Prometheus treats as absent (no labels added).
  external_labels = {
    labdog_host_id  = "{{ labdog_host_id | default('') }}",
    labdog_hostname = "{{ labdog_hostname | default(inventory_hostname) }}",
  }

  endpoint {
    url = "{{ alloy_prometheus_url }}"

    headers = {
      "X-Scope-OrgID" = "{{ alloy_mimir_org_id }}",
    }

    tls_config {
      insecure_skip_verify = {{ alloy_prometheus_tls_insecure_skip_verify | bool | lower }}
    }
{% if alloy_drop_label_regex | default('', true) | length > 0 %}

    // Labels that only add cardinality. cAdvisor copies every Docker label
    // onto each container series, and image / compose metadata pushed some
    // series past Mimir's default limit of 30 labels (HTTP 400 on push).
    write_relabel_config {
      action = "labeldrop"
      regex  = "{{ alloy_drop_label_regex | trim }}"
    }
{% endif %}
  }
}

loki.write "labdog" {
  endpoint {
    url = "{{ alloy_loki_url }}"
{% if alloy_loki_tenant_id | default('', true) | length > 0 %}
    tenant_id = "{{ alloy_loki_tenant_id }}"
{% endif %}

    tls_config {
      insecure_skip_verify = {{ alloy_loki_tls_insecure_skip_verify | bool | lower }}
    }
  }
}

// loki.write has no external_labels equivalent, so the host-identity labels
// LabDog stamps on metrics (via prometheus.remote_write.external_labels) are
// applied to logs here instead: base log sources forward to this relabel,
// which adds the same labels and passes entries to loki.write.labdog. Empty
// values (Alloy installed outside LabDog) are dropped by relabel, matching
// the metrics behaviour.
loki.relabel "labdog" {
  forward_to = [loki.write.labdog.receiver]

  rule {
    target_label = "labdog_host_id"
    replacement  = "{{ labdog_host_id | default('') }}"
  }

  rule {
    target_label = "labdog_hostname"
    replacement  = "{{ labdog_hostname | default(inventory_hostname) }}"
  }
}
