// Managed by Ansible — do not edit manually

/////////////
// Metrics //
/////////////

prometheus.exporter.cadvisor "labdog_docker" {
  docker_host = "unix:///var/run/docker.sock"
}

prometheus.scrape "labdog_docker" {
  targets    = prometheus.exporter.cadvisor.labdog_docker.targets
  forward_to = [prometheus.relabel.labdog_docker.receiver]
}

prometheus.relabel "labdog_docker" {
  rule {
      target_label = "job"
      replacement = "docker"
  }

  rule {
      target_label = "instance"
      replacement = constants.hostname
  }

  rule {
      source_labels = ["__meta_docker_container_name"]
      regex = "/(.*)"
      target_label = "container"
  }

  rule {
      source_labels = ["__meta_docker_container_log_stream"]
      target_label = "stream"
  }

  forward_to = [
    prometheus.remote_write.labdog.receiver,
  ]
}

////////////
/// Logs ///
////////////

discovery.docker "labdog_docker" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "labdog_docker" {
  targets = discovery.docker.labdog_docker.targets

  rule {
      target_label = "job"
      replacement = "docker"
  }

  rule {
      target_label = "instance"
      replacement = constants.hostname
  }

  rule {
      source_labels = ["__meta_docker_container_name"]
      regex = "/(.*)"
      target_label = "container"
  }

  rule {
      source_labels = ["__meta_docker_container_log_stream"]
      target_label = "stream"
  }
}

loki.source.docker "labdog_docker" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.labdog_docker.targets
  relabel_rules = discovery.relabel.labdog_docker.rules
  // Route through the shared labdog relabel so docker logs also carry the
  // labdog_host_id / labdog_hostname identity labels before hitting
  // loki.write.labdog.
  forward_to    = [loki.relabel.labdog.receiver]
}
