// Managed by Ansible — do not edit manually

prometheus.exporter.self "labdog_alloy" {}

prometheus.scrape "labdog_alloy" {
  targets    = prometheus.exporter.self.labdog_alloy.targets
  forward_to = [prometheus.relabel.labdog_alloy.receiver]
}

prometheus.relabel "labdog_alloy" {
  rule {
    target_label = "job"
    replacement  = "alloy"
  }

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  forward_to = [prometheus.remote_write.labdog.receiver]
}
