// Managed by Ansible — do not edit manually

local.file_match "labdog_file_logs" {
  path_targets = [{% for path in alloy_file_log_paths %}

    {
      __address__ = "localhost",
      __path__    = "{{ path }}",
      instance    = constants.hostname,
      job         = "file_logs",
    },{% endfor %}

  ]
}

loki.source.file "labdog_file_logs" {
  targets    = local.file_match.labdog_file_logs.targets
  forward_to = [loki.relabel.labdog.receiver]
  // A file with no saved position is read from its end, not its start.
  // Otherwise a host whose positions were lost (or that is new to this
  // config) re-sends every matching log with today's timestamp.
  tail_from_end = true
}
