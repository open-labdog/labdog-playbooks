// Managed by Ansible — do not edit manually

prometheus.exporter.postgres "default" {
  data_source_names = ["{{ alloy_postgres_data_source }}"]
}

prometheus.scrape "postgresql" {
  targets    = prometheus.exporter.postgres.default.targets
  forward_to = [prometheus.remote_write.default.receiver]
}

local.file_match "postgresql_logs" {
  path_targets = [
    {__path__ = "/var/log/postgresql/*.log", job = "integrations/postgresql"},
  ]
}

loki.source.file "postgresql" {
  targets    = local.file_match.postgresql_logs.targets
  forward_to = [loki.write.default.receiver]
}
